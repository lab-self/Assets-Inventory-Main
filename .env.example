# ============================================================
# INVENTORY MANAGEMENT
# Environment Configuration Example
# ============================================================
#
# IMPORTANT:
# - This file is safe to commit to Git.
# - NEVER put real passwords, tokens, private keys, or secrets
#   in this file.
# - Production values will be provided separately on Ubuntu /
#   through GitHub Actions Secrets.
#
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

APP_NAME=Inventory Management

APP_VERSION=1.0.0

APP_HOST=0.0.0.0

APP_PORT=4000

APP_URL=http://localhost:4000

FRONTEND_URL=http://localhost:5173


# ============================================================
# FRONTEND
# ============================================================

VITE_APP_NAME=Inventory Management

VITE_API_BASE_URL=http://localhost:4000/api


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_DB=inventory_management

POSTGRES_USER=inventory_app

POSTGRES_PASSWORD=replace-with-a-unique-database-password

POSTGRES_PORT=5432


# ============================================================
# DATABASE CONNECTION
# ============================================================

DATABASE_HOST=postgres

DATABASE_PORT=5432

DATABASE_NAME=inventory_management

DATABASE_USER=inventory_app

DATABASE_PASSWORD=replace-with-a-unique-database-password

DATABASE_SSL=false

DATABASE_POOL_MIN=2

DATABASE_POOL_MAX=20

DATABASE_IDLE_TIMEOUT_MS=30000

DATABASE_CONNECTION_TIMEOUT_MS=10000


# ============================================================
# AUTHENTICATION
# ============================================================

JWT_SECRET=

JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=

JWT_REFRESH_EXPIRES_IN=7d


# ============================================================
# SESSION / COOKIE SECURITY
# ============================================================

SESSION_SECRET=

COOKIE_SECURE=false

COOKIE_HTTP_ONLY=true

COOKIE_SAME_SITE=lax


# ============================================================
# CORS
# ============================================================

CORS_ORIGIN=http://localhost:5173


# ============================================================
# SECURITY
# ============================================================

BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=100

AUTH_RATE_LIMIT_WINDOW_MS=900000

AUTH_RATE_LIMIT_MAX_REQUESTS=10


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=info

LOG_FORMAT=pretty


# ============================================================
# FILE / IMPORT SETTINGS
# ============================================================

MAX_UPLOAD_SIZE_MB=20

ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.xls,.csv


# ============================================================
# PAGINATION
# ============================================================

DEFAULT_PAGE_SIZE=25

MAX_PAGE_SIZE=100


# ============================================================
# AUDIT LOGGING
# ============================================================

AUDIT_LOG_RETENTION_DAYS=365


# ============================================================
# INVENTORY
# ============================================================

WARRANTY_EXPIRY_WARNING_DAYS=30

LICENSE_EXPIRY_WARNING_DAYS=30


# ============================================================
# EMAIL
# ============================================================
#
# Optional for initial deployment.
# Required later if email notifications are enabled.
#

SMTP_HOST=

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=

SMTP_PASSWORD=

SMTP_FROM_NAME=Inventory Management

SMTP_FROM_EMAIL=


# ============================================================
# APPLICATION ADMINISTRATION
# ============================================================
#
# Used only during secure initial administrator creation.
# Do NOT store the production administrator password here.
#

ADMIN_EMAIL=admin@example.com

ADMIN_PASSWORD=